{
   "data": {
      "chapter": {
         "bibleId": "01b58d476a09e6a6-01",
         "bookId": "PRO",
         "id": "PRO.3",
         "content": [
            {
               "type": "paragraph",
               "style": "s",
               "content": [
                  {
                     "type": "text",
                     "content": "Heb ontzag voor de "
                  },
                  {
                     "type": "char",
                     "content": "HEER",
                     "style": "nd"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.1",
                     "verseOrgId": [
                        "PRO.3.1"
                     ],
                     "content": "1"
                  },
                  {
                     "id": "CR.1",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.1",
                     "verseOrgId": [
                        "PRO.3.1"
                     ]
                  },
                  {
                     "id": "CR.2",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.1",
                     "verseOrgId": [
                        "PRO.3.1"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.1",
                     "verseOrgId": [
                        "PRO.3.1"
                     ],
                     "content": "Mijn zoon, vergeet mijn lessen niet,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.1",
                     "verseOrgId": [
                        "PRO.3.1"
                     ],
                     "content": "houd in je hart mijn richtlijnen vast."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.2",
                     "verseOrgId": [
                        "PRO.3.2"
                     ],
                     "content": "2"
                  },
                  {
                     "id": "CR.3",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.2",
                     "verseOrgId": [
                        "PRO.3.2"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.2",
                     "verseOrgId": [
                        "PRO.3.2"
                     ],
                     "content": "Ze vermeerderen de dagen van je leven,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.2",
                     "verseOrgId": [
                        "PRO.3.2"
                     ],
                     "content": "geven je vele jaren van geluk."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.3",
                     "verseOrgId": [
                        "PRO.3.3"
                     ],
                     "content": "3"
                  },
                  {
                     "id": "CR.4",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.3",
                     "verseOrgId": [
                        "PRO.3.3"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.3",
                     "verseOrgId": [
                        "PRO.3.3"
                     ],
                     "content": "Mogen liefde en trouw je nooit verlaten,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.3",
                     "verseOrgId": [
                        "PRO.3.3"
                     ],
                     "content": "wind ze om je hals,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.3",
                     "verseOrgId": [
                        "PRO.3.3"
                     ],
                     "content": "schrijf ze in je hart."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.4",
                     "verseOrgId": [
                        "PRO.3.4"
                     ],
                     "content": "4"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.4",
                     "verseOrgId": [
                        "PRO.3.4"
                     ],
                     "content": "God en de mensen zullen je genegen zijn"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.4",
                     "verseOrgId": [
                        "PRO.3.4"
                     ],
                     "content": "en je zult waardering ondervinden."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.5",
                     "verseOrgId": [
                        "PRO.3.5"
                     ],
                     "content": "5"
                  },
                  {
                     "id": "CR.5",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.5",
                     "verseOrgId": [
                        "PRO.3.5"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.5",
                     "verseOrgId": [
                        "PRO.3.5"
                     ],
                     "content": "Vertrouw op de "
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.5",
                     "verseOrgId": [
                        "PRO.3.5"
                     ],
                     "content": "HEER",
                     "style": "nd"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.5",
                     "verseOrgId": [
                        "PRO.3.5"
                     ],
                     "content": " met heel je hart,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.5",
                     "verseOrgId": [
                        "PRO.3.5"
                     ],
                     "content": "steun niet op eigen inzicht."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.6",
                     "verseOrgId": [
                        "PRO.3.6"
                     ],
                     "content": "6"
                  },
                  {
                     "id": "CR.6",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.6",
                     "verseOrgId": [
                        "PRO.3.6"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.6",
                     "verseOrgId": [
                        "PRO.3.6"
                     ],
                     "content": "Denk aan Hem bij alles wat je doet,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.6",
                     "verseOrgId": [
                        "PRO.3.6"
                     ],
                     "content": "dan baant Hij voor jou de weg."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.7",
                     "verseOrgId": [
                        "PRO.3.7"
                     ],
                     "content": "7"
                  },
                  {
                     "id": "CR.7",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.7",
                     "verseOrgId": [
                        "PRO.3.7"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.7",
                     "verseOrgId": [
                        "PRO.3.7"
                     ],
                     "content": "Wees niet eigenzinnig,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.7",
                     "verseOrgId": [
                        "PRO.3.7"
                     ],
                     "content": "maar heb ontzag voor de "
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.7",
                     "verseOrgId": [
                        "PRO.3.7"
                     ],
                     "content": "HEER",
                     "style": "nd"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.7",
                     "verseOrgId": [
                        "PRO.3.7"
                     ],
                     "content": "en ga het kwaad uit de weg."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.8",
                     "verseOrgId": [
                        "PRO.3.8"
                     ],
                     "content": "8"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.8",
                     "verseOrgId": [
                        "PRO.3.8"
                     ],
                     "content": "Het zal je sterken als een medicijn,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.8",
                     "verseOrgId": [
                        "PRO.3.8"
                     ],
                     "content": "het verkwikt je lichaam."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.9",
                     "verseOrgId": [
                        "PRO.3.9"
                     ],
                     "content": "9"
                  },
                  {
                     "id": "CR.8",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.9",
                     "verseOrgId": [
                        "PRO.3.9"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.9",
                     "verseOrgId": [
                        "PRO.3.9"
                     ],
                     "content": "Eer de "
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.9",
                     "verseOrgId": [
                        "PRO.3.9"
                     ],
                     "content": "HEER",
                     "style": "nd"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.9",
                     "verseOrgId": [
                        "PRO.3.9"
                     ],
                     "content": " met al je rijkdom,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.9",
                     "verseOrgId": [
                        "PRO.3.9"
                     ],
                     "content": "met het beste van de oogst."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.10",
                     "verseOrgId": [
                        "PRO.3.10"
                     ],
                     "content": "10"
                  },
                  {
                     "id": "CR.9",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.10",
                     "verseOrgId": [
                        "PRO.3.10"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.10",
                     "verseOrgId": [
                        "PRO.3.10"
                     ],
                     "content": "Graan zal je voorraadschuren vullen,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.10",
                     "verseOrgId": [
                        "PRO.3.10"
                     ],
                     "content": "je kuipen lopen over van wijn."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.11",
                     "verseOrgId": [
                        "PRO.3.11"
                     ],
                     "content": "11"
                  },
                  {
                     "id": "CR.10",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.11",
                     "verseOrgId": [
                        "PRO.3.11"
                     ]
                  },
                  {
                     "id": "CR.11",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.11",
                     "verseOrgId": [
                        "PRO.3.11"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.11",
                     "verseOrgId": [
                        "PRO.3.11"
                     ],
                     "content": "Mijn zoon, een berisping van de "
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.11",
                     "verseOrgId": [
                        "PRO.3.11"
                     ],
                     "content": "HEER",
                     "style": "nd"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.11",
                     "verseOrgId": [
                        "PRO.3.11"
                     ],
                     "content": "mag je nooit terzijde schuiven,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.11",
                     "verseOrgId": [
                        "PRO.3.11"
                     ],
                     "content": "zijn bestraffing moet je zonder afschuw ondergaan,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.12",
                     "verseOrgId": [
                        "PRO.3.12"
                     ],
                     "content": "12"
                  },
                  {
                     "id": "CR.12",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.12",
                     "verseOrgId": [
                        "PRO.3.12"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.12",
                     "verseOrgId": [
                        "PRO.3.12"
                     ],
                     "content": "want de "
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.12",
                     "verseOrgId": [
                        "PRO.3.12"
                     ],
                     "content": "HEER",
                     "style": "nd"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.12",
                     "verseOrgId": [
                        "PRO.3.12"
                     ],
                     "content": " straft wie Hij liefheeft,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.12",
                     "verseOrgId": [
                        "PRO.3.12"
                     ],
                     "content": "als een vader die van zijn kinderen houdt."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.13",
                     "verseOrgId": [
                        "PRO.3.13"
                     ],
                     "content": "13"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.13",
                     "verseOrgId": [
                        "PRO.3.13"
                     ],
                     "content": "Gelukkig de mens die wijsheid ontdekt,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.13",
                     "verseOrgId": [
                        "PRO.3.13"
                     ],
                     "content": "de mens die inzicht wint."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.14",
                     "verseOrgId": [
                        "PRO.3.14"
                     ],
                     "content": "14"
                  },
                  {
                     "id": "CR.13",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.14",
                     "verseOrgId": [
                        "PRO.3.14"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.14",
                     "verseOrgId": [
                        "PRO.3.14"
                     ],
                     "content": "Wijsheid levert meer op dan zilver,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.14",
                     "verseOrgId": [
                        "PRO.3.14"
                     ],
                     "content": "geeft meer profijt dan goud,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.15",
                     "verseOrgId": [
                        "PRO.3.15"
                     ],
                     "content": "15"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.15",
                     "verseOrgId": [
                        "PRO.3.15"
                     ],
                     "content": "is kostbaarder dan edelstenen."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.15",
                     "verseOrgId": [
                        "PRO.3.15"
                     ],
                     "content": "Alles wat je ooit zou kunnen wensen"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.15",
                     "verseOrgId": [
                        "PRO.3.15"
                     ],
                     "content": "valt bij de wijsheid in het niet."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.16",
                     "verseOrgId": [
                        "PRO.3.16"
                     ],
                     "content": "16"
                  },
                  {
                     "id": "CR.14",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.16",
                     "verseOrgId": [
                        "PRO.3.16"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.16",
                     "verseOrgId": [
                        "PRO.3.16"
                     ],
                     "content": "Met haar ene hand schenkt ze een lang leven,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.16",
                     "verseOrgId": [
                        "PRO.3.16"
                     ],
                     "content": "eer en rijkdom geeft ze met haar andere hand."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.17",
                     "verseOrgId": [
                        "PRO.3.17"
                     ],
                     "content": "17"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.17",
                     "verseOrgId": [
                        "PRO.3.17"
                     ],
                     "content": "De wegen van de wijsheid zijn lieflijk,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.17",
                     "verseOrgId": [
                        "PRO.3.17"
                     ],
                     "content": "al haar paden vredig."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.18",
                     "verseOrgId": [
                        "PRO.3.18"
                     ],
                     "content": "18"
                  },
                  {
                     "id": "CR.15",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.18",
                     "verseOrgId": [
                        "PRO.3.18"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.18",
                     "verseOrgId": [
                        "PRO.3.18"
                     ],
                     "content": "Ze is een levensboom voor wie haar omhelst,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.18",
                     "verseOrgId": [
                        "PRO.3.18"
                     ],
                     "content": "wie haar omarmt, mag zich gelukkig prijzen."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.19",
                     "verseOrgId": [
                        "PRO.3.19"
                     ],
                     "content": "19"
                  },
                  {
                     "id": "CR.16",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.19",
                     "verseOrgId": [
                        "PRO.3.19"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.19",
                     "verseOrgId": [
                        "PRO.3.19"
                     ],
                     "content": "De "
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.19",
                     "verseOrgId": [
                        "PRO.3.19"
                     ],
                     "content": "HEER",
                     "style": "nd"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.19",
                     "verseOrgId": [
                        "PRO.3.19"
                     ],
                     "content": " heeft de aarde met wijsheid gegrondvest,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.19",
                     "verseOrgId": [
                        "PRO.3.19"
                     ],
                     "content": "de hemel met inzicht gevestigd."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.20",
                     "verseOrgId": [
                        "PRO.3.20"
                     ],
                     "content": "20"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.20",
                     "verseOrgId": [
                        "PRO.3.20"
                     ],
                     "content": "Door zijn kennis brak het water los uit de diepte"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.20",
                     "verseOrgId": [
                        "PRO.3.20"
                     ],
                     "content": "en druppelt er dauw uit de wolken."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.21",
                     "verseOrgId": [
                        "PRO.3.21"
                     ],
                     "content": "21"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.21",
                     "verseOrgId": [
                        "PRO.3.21"
                     ],
                     "content": "Mijn zoon, streef naar bedachtzaamheid en tact,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.21",
                     "verseOrgId": [
                        "PRO.3.21"
                     ],
                     "content": "verlies die nooit uit het oog."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.22",
                     "verseOrgId": [
                        "PRO.3.22"
                     ],
                     "content": "22"
                  },
                  {
                     "id": "CR.17",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.22",
                     "verseOrgId": [
                        "PRO.3.22"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.22",
                     "verseOrgId": [
                        "PRO.3.22"
                     ],
                     "content": "Ze zullen een bron van leven voor je zijn,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.22",
                     "verseOrgId": [
                        "PRO.3.22"
                     ],
                     "content": "een sieraad om je hals."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.23",
                     "verseOrgId": [
                        "PRO.3.23"
                     ],
                     "content": "23"
                  },
                  {
                     "id": "CR.18",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.23",
                     "verseOrgId": [
                        "PRO.3.23"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.23",
                     "verseOrgId": [
                        "PRO.3.23"
                     ],
                     "content": "Je zult veilig je weg kunnen gaan,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.23",
                     "verseOrgId": [
                        "PRO.3.23"
                     ],
                     "content": "nergens zul je struikelen."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.24",
                     "verseOrgId": [
                        "PRO.3.24"
                     ],
                     "content": "24"
                  },
                  {
                     "id": "CR.19",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.24",
                     "verseOrgId": [
                        "PRO.3.24"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.24",
                     "verseOrgId": [
                        "PRO.3.24"
                     ],
                     "content": "Je hoeft niet bang te zijn wanneer je slapen gaat,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.24",
                     "verseOrgId": [
                        "PRO.3.24"
                     ],
                     "content": "je slaap zal vredig zijn."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.25",
                     "verseOrgId": [
                        "PRO.3.25"
                     ],
                     "content": "25"
                  },
                  {
                     "id": "CR.20",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.25",
                     "verseOrgId": [
                        "PRO.3.25"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.25",
                     "verseOrgId": [
                        "PRO.3.25"
                     ],
                     "content": "En wees niet bang voor plotseling onheil,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.25",
                     "verseOrgId": [
                        "PRO.3.25"
                     ],
                     "content": "voor de rampspoed die goddelozen overkomt."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.26",
                     "verseOrgId": [
                        "PRO.3.26"
                     ],
                     "content": "26"
                  },
                  {
                     "id": "CR.21",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.26",
                     "verseOrgId": [
                        "PRO.3.26"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.26",
                     "verseOrgId": [
                        "PRO.3.26"
                     ],
                     "content": "Je kunt vertrouwen op de "
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.26",
                     "verseOrgId": [
                        "PRO.3.26"
                     ],
                     "content": "HEER",
                     "style": "nd"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.26",
                     "verseOrgId": [
                        "PRO.3.26"
                     ],
                     "content": ","
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.26",
                     "verseOrgId": [
                        "PRO.3.26"
                     ],
                     "content": "Hij beschermt je tegen hinderlagen."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "b"
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.27",
                     "verseOrgId": [
                        "PRO.3.27"
                     ],
                     "content": "27"
                  },
                  {
                     "id": "CR.22",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.27",
                     "verseOrgId": [
                        "PRO.3.27"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.27",
                     "verseOrgId": [
                        "PRO.3.27"
                     ],
                     "content": "Onthoud een ander niet waarop hij recht heeft,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.27",
                     "verseOrgId": [
                        "PRO.3.27"
                     ],
                     "content": "terwijl je het hem geven kunt."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.28",
                     "verseOrgId": [
                        "PRO.3.28"
                     ],
                     "content": "28"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.28",
                     "verseOrgId": [
                        "PRO.3.28"
                     ],
                     "content": "Zeg nooit tegen je medemens:"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.28",
                     "verseOrgId": [
                        "PRO.3.28"
                     ],
                     "content": "\u2018Ga weg, kom morgen maar terug,\u2019"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.28",
                     "verseOrgId": [
                        "PRO.3.28"
                     ],
                     "content": "terwijl je hebt wat je hem schuldig bent."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.29",
                     "verseOrgId": [
                        "PRO.3.29"
                     ],
                     "content": "29"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.29",
                     "verseOrgId": [
                        "PRO.3.29"
                     ],
                     "content": "Behandel hem niet zo schandalig"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.29",
                     "verseOrgId": [
                        "PRO.3.29"
                     ],
                     "content": "terwijl hij zijn vertrouwen in je heeft gesteld."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.30",
                     "verseOrgId": [
                        "PRO.3.30"
                     ],
                     "content": "30"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.30",
                     "verseOrgId": [
                        "PRO.3.30"
                     ],
                     "content": "Maak geen ruzie met iemand"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.30",
                     "verseOrgId": [
                        "PRO.3.30"
                     ],
                     "content": "die je geen kwaad berokkend heeft."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.31",
                     "verseOrgId": [
                        "PRO.3.31"
                     ],
                     "content": "31"
                  },
                  {
                     "id": "CR.23",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.31",
                     "verseOrgId": [
                        "PRO.3.31"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.31",
                     "verseOrgId": [
                        "PRO.3.31"
                     ],
                     "content": "Wees niet jaloers op iemand die geweld gebruikt,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.31",
                     "verseOrgId": [
                        "PRO.3.31"
                     ],
                     "content": "volg hem beslist niet na,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.32",
                     "verseOrgId": [
                        "PRO.3.32"
                     ],
                     "content": "32"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.32",
                     "verseOrgId": [
                        "PRO.3.32"
                     ],
                     "content": "want de "
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.32",
                     "verseOrgId": [
                        "PRO.3.32"
                     ],
                     "content": "HEER",
                     "style": "nd"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.32",
                     "verseOrgId": [
                        "PRO.3.32"
                     ],
                     "content": " verafschuwt wie dat dwaalspoor gaat,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.32",
                     "verseOrgId": [
                        "PRO.3.32"
                     ],
                     "content": "maar wie rechtschapen is geeft Hij zijn vertrouwen."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.33",
                     "verseOrgId": [
                        "PRO.3.33"
                     ],
                     "content": "33"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.33",
                     "verseOrgId": [
                        "PRO.3.33"
                     ],
                     "content": "De "
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.33",
                     "verseOrgId": [
                        "PRO.3.33"
                     ],
                     "content": "HEER",
                     "style": "nd"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.33",
                     "verseOrgId": [
                        "PRO.3.33"
                     ],
                     "content": " vervloekt het huis van goddelozen,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.33",
                     "verseOrgId": [
                        "PRO.3.33"
                     ],
                     "content": "maar de woning van rechtvaardigen zegent Hij."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.34",
                     "verseOrgId": [
                        "PRO.3.34"
                     ],
                     "content": "34"
                  },
                  {
                     "id": "CR.24",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "PRO.3.34",
                     "verseOrgId": [
                        "PRO.3.34"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.34",
                     "verseOrgId": [
                        "PRO.3.34"
                     ],
                     "content": "Met spotters drijft Hij de spot,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.34",
                     "verseOrgId": [
                        "PRO.3.34"
                     ],
                     "content": "maar verdrukten schenkt Hij zijn gunst."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "PRO.3.35",
                     "verseOrgId": [
                        "PRO.3.35"
                     ],
                     "content": "35"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.35",
                     "verseOrgId": [
                        "PRO.3.35"
                     ],
                     "content": "Wijzen verwerven eer,"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "q",
               "content": [
                  {
                     "type": "verse-text",
                     "verseId": "PRO.3.35",
                     "verseOrgId": [
                        "PRO.3.35"
                     ],
                     "content": "dwazen torsen schande."
                  }
               ]
            }
         ],
