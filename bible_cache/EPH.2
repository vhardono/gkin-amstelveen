{
   "data": {
      "chapter": {
         "bibleId": "01b58d476a09e6a6-01",
         "bookId": "EPH",
         "id": "EPH.2",
         "content": [
            {
               "type": "paragraph",
               "style": "s",
               "content": [
                  {
                     "type": "text",
                     "content": "E\u00e9n in Christus"
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "p",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.1",
                     "verseOrgId": [
                        "EPH.2.1"
                     ],
                     "content": "1"
                  },
                  {
                     "id": "CR.1",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.1",
                     "verseOrgId": [
                        "EPH.2.1"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.1",
                     "verseOrgId": [
                        "EPH.2.1"
                     ],
                     "content": "U was dood door de misstappen en zonden "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.2",
                     "verseOrgId": [
                        "EPH.2.2"
                     ],
                     "content": "2"
                  },
                  {
                     "id": "CR.2",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.2",
                     "verseOrgId": [
                        "EPH.2.2"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.2",
                     "verseOrgId": [
                        "EPH.2.2"
                     ],
                     "content": "waarmee u voorheen de weg ging van de god van deze wereld, de heerser over de machten in de lucht, de geest die nu werkzaam is in hen die God ongehoorzaam zijn. "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.3",
                     "verseOrgId": [
                        "EPH.2.3"
                     ],
                     "content": "3"
                  },
                  {
                     "id": "CR.3",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.3",
                     "verseOrgId": [
                        "EPH.2.3"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.3",
                     "verseOrgId": [
                        "EPH.2.3"
                     ],
                     "content": "Eens leefden wij allen net als zij: wij volgden onze wereldse begeerten en alle aardse verlangens die in ons opkwamen en stonden van nature bloot aan Gods toorn, net als ieder ander. "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.4",
                     "verseOrgId": [
                        "EPH.2.4"
                     ],
                     "content": "4"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.4",
                     "verseOrgId": [
                        "EPH.2.4"
                     ],
                     "content": "Maar omdat God zo barmhartig is en de liefde die Hij voor ons heeft opgevat zo groot, "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.5",
                     "verseOrgId": [
                        "EPH.2.5"
                     ],
                     "content": "5"
                  },
                  {
                     "id": "CR.4",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.5",
                     "verseOrgId": [
                        "EPH.2.5"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.5",
                     "verseOrgId": [
                        "EPH.2.5"
                     ],
                     "content": "heeft Hij ons, terwijl wij allen dood waren door onze zonden, samen met Christus levend gemaakt. Door genade bent u gered! "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.6",
                     "verseOrgId": [
                        "EPH.2.6"
                     ],
                     "content": "6"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.6",
                     "verseOrgId": [
                        "EPH.2.6"
                     ],
                     "content": "Hij heeft ons samen met Hem tot leven gewekt en ons een plaats gegeven in de hemelsferen, in Christus Jezus. "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.7",
                     "verseOrgId": [
                        "EPH.2.7"
                     ],
                     "content": "7"
                  },
                  {
                     "id": "CR.5",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.7",
                     "verseOrgId": [
                        "EPH.2.7"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.7",
                     "verseOrgId": [
                        "EPH.2.7"
                     ],
                     "content": "Zo zal Hij, in de eeuwen die komen, laten zien hoe overweldigend rijk zijn genade is, hoe goed Hij voor ons is in Christus Jezus. "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.8",
                     "verseOrgId": [
                        "EPH.2.8"
                     ],
                     "content": "8"
                  },
                  {
                     "id": "CR.6",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.8",
                     "verseOrgId": [
                        "EPH.2.8"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.8",
                     "verseOrgId": [
                        "EPH.2.8"
                     ],
                     "content": "Door die genade bent u nu immers gered, doordat u gelooft. Deze redding dankt u niet aan uzelf; ze is een geschenk van God "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.9",
                     "verseOrgId": [
                        "EPH.2.9"
                     ],
                     "content": "9"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.9",
                     "verseOrgId": [
                        "EPH.2.9"
                     ],
                     "content": "en geen gevolg van uw daden. Niemand kan zich er dus op laten voorstaan. "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.10",
                     "verseOrgId": [
                        "EPH.2.10"
                     ],
                     "content": "10"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.10",
                     "verseOrgId": [
                        "EPH.2.10"
                     ],
                     "content": "Want Hij is het die ons gemaakt heeft tot wat wij nu zijn: in Christus Jezus geschapen om de weg te gaan van de goede daden die God heeft voorbereid."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "p",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.11",
                     "verseOrgId": [
                        "EPH.2.11"
                     ],
                     "content": "11"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.11",
                     "verseOrgId": [
                        "EPH.2.11"
                     ],
                     "content": "Bedenk daarom dat u, die geen geboren Joden bent en onbesnedenen genoemd wordt door hen die door mensenhanden besneden zijn\u00a0\u2013 "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.12",
                     "verseOrgId": [
                        "EPH.2.12"
                     ],
                     "content": "12"
                  },
                  {
                     "id": "CR.7",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.12",
                     "verseOrgId": [
                        "EPH.2.12"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.12",
                     "verseOrgId": [
                        "EPH.2.12"
                     ],
                     "content": "bedenk dat u destijds niet verbonden was met Christus, uitgesloten was van het burgerschap van Isra\u00ebl en geen deel had aan de verbondssluitingen en de beloften die daarbij hoorden. U leefde zonder hoop en zonder God in deze wereld. "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.13",
                     "verseOrgId": [
                        "EPH.2.13"
                     ],
                     "content": "13"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.13",
                     "verseOrgId": [
                        "EPH.2.13"
                     ],
                     "content": "Maar nu bent u, die eens ver weg was, in Christus Jezus dichtbij gekomen, door zijn bloed. "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.14",
                     "verseOrgId": [
                        "EPH.2.14"
                     ],
                     "content": "14"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.14",
                     "verseOrgId": [
                        "EPH.2.14"
                     ],
                     "content": "Want Hij is onze vrede: Hij heeft met zijn dood Joden en niet-Joden verenigd, de muur van vijandschap, die hen scheidde, afgebroken "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.15",
                     "verseOrgId": [
                        "EPH.2.15"
                     ],
                     "content": "15"
                  },
                  {
                     "id": "CR.8",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.15",
                     "verseOrgId": [
                        "EPH.2.15"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.15",
                     "verseOrgId": [
                        "EPH.2.15"
                     ],
                     "content": "en de wet met zijn geboden en voorschriften buiten werking gesteld, om uit die twee in zichzelf \u00e9\u00e9n nieuwe mens te scheppen. Zo bracht Hij vrede "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.16",
                     "verseOrgId": [
                        "EPH.2.16"
                     ],
                     "content": "16"
                  },
                  {
                     "id": "CR.9",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.16",
                     "verseOrgId": [
                        "EPH.2.16"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.16",
                     "verseOrgId": [
                        "EPH.2.16"
                     ],
                     "content": "en verzoende Hij door het kruis beiden in \u00e9\u00e9n lichaam met God, door in zijn lichaam de vijandschap te doden. "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.17",
                     "verseOrgId": [
                        "EPH.2.17"
                     ],
                     "content": "17"
                  },
                  {
                     "id": "CR.10",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.17",
                     "verseOrgId": [
                        "EPH.2.17"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.17",
                     "verseOrgId": [
                        "EPH.2.17"
                     ],
                     "content": "Vrede kwam Hij verkondigen aan u die ver weg was en vrede aan hen die dichtbij waren: "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.18",
                     "verseOrgId": [
                        "EPH.2.18"
                     ],
                     "content": "18"
                  },
                  {
                     "id": "CR.11",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.18",
                     "verseOrgId": [
                        "EPH.2.18"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.18",
                     "verseOrgId": [
                        "EPH.2.18"
                     ],
                     "content": "dankzij Hem hebben wij allen door \u00e9\u00e9n Geest toegang tot de Vader."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "p",
               "content": [
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.19",
                     "verseOrgId": [
                        "EPH.2.19"
                     ],
                     "content": "19"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.19",
                     "verseOrgId": [
                        "EPH.2.19"
                     ],
                     "content": "Zo bent u dus geen vreemdelingen of gasten meer, maar burgers, net als de heiligen, en huisgenoten van God, "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.20",
                     "verseOrgId": [
                        "EPH.2.20"
                     ],
                     "content": "20"
                  },
                  {
                     "id": "CR.12",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.20",
                     "verseOrgId": [
                        "EPH.2.20"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.20",
                     "verseOrgId": [
                        "EPH.2.20"
                     ],
                     "content": "gebouwd op het fundament van de apostelen en profeten, met Christus Jezus zelf als de hoeksteen. "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.21",
                     "verseOrgId": [
                        "EPH.2.21"
                     ],
                     "content": "21"
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.21",
                     "verseOrgId": [
                        "EPH.2.21"
                     ],
                     "content": "In Hem vormt het bouwwerk \u00e9\u00e9n geheel en groeit het uit tot een tempel die gewijd is aan de Heer, "
                  },
                  {
                     "type": "verse-number",
                     "style": "v",
                     "verseId": "EPH.2.22",
                     "verseOrgId": [
                        "EPH.2.22"
                     ],
                     "content": "22"
                  },
                  {
                     "id": "CR.13",
                     "type": "study",
                     "subtype": "crossreference",
                     "verseId": "EPH.2.22",
                     "verseOrgId": [
                        "EPH.2.22"
                     ]
                  },
                  {
                     "type": "verse-text",
                     "verseId": "EPH.2.22",
                     "verseOrgId": [
                        "EPH.2.22"
                     ],
                     "content": "in wie ook u samen opgebouwd wordt tot een plaats waar God woont door zijn Geest."
                  }
               ]
            },
            {
               "type": "paragraph",
               "style": "b"
            }
         ],
